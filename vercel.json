{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node@3.0.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static@1.0.5"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.html"
        }
    ]
}