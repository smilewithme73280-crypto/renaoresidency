{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node@3.0.0"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build@1.0.0",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.js"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}